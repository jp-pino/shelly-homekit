{
  "expo": {
    "name": "Shelly HomeKit Setup",
    "slug": "shelly-homekit-setup",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "io.github.jppino.shellyhomekit.setup",
      "appleTeamId": "C698838EFC",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is used to discover nearby Shelly devices and configure their WiFi.",
        "NSLocationWhenInUseUsageDescription": "Location access lets the app read your current WiFi network name to pre-fill it during setup."
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "io.github.jppino.shellyhomekit.setup",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to use Bluetooth to set up Shelly devices"
        }
      ],
      "expo-asset"
    ]
  }
}
